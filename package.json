{
  "name": "@ismail-elkorchi/terminal-ui",
  "version": "0.1.5",
  "description": "Typed terminal UI framework for prompts, full-screen apps, accessible components, deterministic rendering, and testing.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ismail-elkorchi/terminal-ui.git"
  },
  "homepage": "https://github.com/Ismail-elkorchi/terminal-ui#readme",
  "bugs": {
    "url": "https://github.com/Ismail-elkorchi/terminal-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "npm@11.8.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./input": {
      "types": "./dist/input/index.d.ts",
      "default": "./dist/input/index.js"
    },
    "./interaction": {
      "types": "./dist/interaction/index.d.ts",
      "default": "./dist/interaction/index.js"
    },
    "./collection": {
      "types": "./dist/collection/index.d.ts",
      "default": "./dist/collection/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./text": {
      "types": "./dist/text/index.d.ts",
      "default": "./dist/text/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./theme/packs": {
      "types": "./dist/theme/packs/index.d.ts",
      "default": "./dist/theme/packs/index.js"
    },
    "./prompts": {
      "types": "./dist/prompts/index.d.ts",
      "default": "./dist/prompts/index.js"
    },
    "./tui": {
      "types": "./dist/tui/index.d.ts",
      "default": "./dist/tui/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./components/foundations": {
      "types": "./dist/components/foundations.d.ts",
      "default": "./dist/components/foundations.js"
    },
    "./components/forms": {
      "types": "./dist/components/forms.d.ts",
      "default": "./dist/components/forms.js"
    },
    "./components/collections": {
      "types": "./dist/components/collections.d.ts",
      "default": "./dist/components/collections.js"
    },
    "./components/overlays": {
      "types": "./dist/components/overlays.d.ts",
      "default": "./dist/components/overlays.js"
    },
    "./components/feedback": {
      "types": "./dist/components/feedback.d.ts",
      "default": "./dist/components/feedback.js"
    },
    "./components/patterns": {
      "types": "./dist/components/patterns.d.ts",
      "default": "./dist/components/patterns.js"
    },
    "./components/visualizations": {
      "types": "./dist/components/visualizations.d.ts",
      "default": "./dist/components/visualizations.js"
    },
    "./component": {
      "types": "./dist/component/index.d.ts",
      "default": "./dist/component/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "default": "./dist/layout/index.js"
    },
    "./behavior": {
      "types": "./dist/behavior/index.d.ts",
      "default": "./dist/behavior/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "default": "./dist/renderer/index.js"
    },
    "./graphics": {
      "types": "./dist/graphics/index.d.ts",
      "default": "./dist/graphics/index.js"
    },
    "./accessibility": {
      "types": "./dist/accessibility/index.d.ts",
      "default": "./dist/accessibility/index.js"
    },
    "./transcript": {
      "types": "./dist/transcript/index.d.ts",
      "default": "./dist/transcript/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "lint": "eslint \"src/**/*.ts\" \"examples/**/*.{ts,mjs}\" \"scripts/**/*.mjs\" \"tests/**/*.{ts,mjs}\"",
    "check:architecture": "npm run build && node scripts/check-architecture.mjs && node --test tests/architecture/check-architecture.test.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "check": "npm run check:fast && npm run check:consumer && npm run check:runtime && npm run check:jsr && npm run check:performance",
    "check:fast": "npm run check:hygiene && npm run check:release && npm run check:architecture && npm run check:api && npm run lint && npm run check:test-types && npm run check:examples && npm run check:acceptance && npm run check:conformance && npm run check:integration && npm run check:package && npm run check:invariants && npm run check:security-smoke && npm run check:unit && npm run check:mutation",
    "check:api": "node scripts/generate-api-reference.mjs --check",
    "check:acceptance": "node scripts/run-test-lane.mjs acceptance",
    "check:conformance": "node scripts/run-test-lane.mjs conformance",
    "check:examples": "tsc --project tsconfig.examples.json",
    "check:integration": "node scripts/run-test-lane.mjs integration",
    "check:invariants": "node scripts/run-test-lane.mjs invariants",
    "check:jsr": "deno publish --dry-run --allow-dirty --quiet && node scripts/check-jsr-runtime.mjs",
    "check:package": "node scripts/run-test-lane.mjs package",
    "check:consumer": "node scripts/check-packed-consumer.mjs",
    "check:performance": "node scripts/run-test-lane.mjs performance",
    "check:release": "node scripts/check-release-metadata.mjs",
    "check:runtime": "node scripts/run-test-lane.mjs runtime",
    "check:security-smoke": "node scripts/run-test-lane.mjs security-smoke",
    "check:test-types": "tsc --project tsconfig.tests.json",
    "check:unit": "node scripts/check-unit.mjs",
    "check:mutation": "node scripts/check-mutation-samples.mjs",
    "benchmark:interactive": "npm run build && node scripts/benchmark-interactive.mjs",
    "benchmark:baseline": "npm run build && node scripts/capture-performance-baseline.mjs",
    "benchmark:compare": "node scripts/check-performance-report.mjs",
    "docs:api": "npm run build && node scripts/generate-api-reference.mjs",
    "test": "npm run check",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "terminal",
    "terminal-ui",
    "cli",
    "prompts",
    "tui",
    "typescript",
    "deno",
    "bun",
    "accessibility",
    "testing"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  }
}
