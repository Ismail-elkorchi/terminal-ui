{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ismail-elkorchi.dev/terminal-ui/accessible-snapshot.schema.json",
  "type": "object",
  "required": ["schemaVersion", "source", "root", "focusPath", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": "terminal-ui.accessible-snapshot.v1" },
    "source": { "enum": ["prompt", "tui", "renderer", "progress", "test_harness"] },
    "title": { "type": "string" },
    "root": { "$ref": "#/$defs/accessibleNode" },
    "focusPath": { "type": "array", "items": { "type": "string" } },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "https://schemas.ismail-elkorchi.dev/terminal-ui/terminal-diagnostic.schema.json" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "accessibleNode": {
      "type": "object",
      "required": ["id", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": {
          "enum": [
            "application",
            "document",
            "dialog",
            "form",
            "group",
            "heading",
            "link",
            "navigation",
            "status",
            "progressbar",
            "meter",
            "textbox",
            "button",
            "checkbox",
            "switch",
            "radio",
            "radiogroup",
            "slider",
            "spinbutton",
            "combobox",
            "listbox",
            "option",
        "menu",
            "menubar",
            "menuitem",
            "menuitemcheckbox",
            "menuitemradio",
            "tablist",
            "tab",
            "tabpanel",
            "list",
            "listitem",
            "table",
            "grid",
            "rowgroup",
            "row",
            "cell",
            "gridcell",
            "columnheader",
            "rowheader",
            "tree",
            "treeitem",
            "image",
            "text"
          ]
        },
        "label": { "type": "string" },
        "value": {
          "anyOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "focused": { "type": "boolean" },
        "selected": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "expanded": { "type": "boolean" },
        "checked": { "anyOf": [{ "type": "boolean" }, { "const": "mixed" }] },
        "numericValue": {
          "type": "object",
          "properties": {
            "current": { "type": "number" },
            "minimum": { "type": "number" },
            "maximum": { "type": "number" },
            "indeterminate": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "live": { "enum": ["off", "polite", "assertive"] },
        "scope": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["document", "modal", "popover", "menu"] },
            "trapsFocus": { "type": "boolean" },
            "obscuresBackground": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "window": {
          "type": "object",
          "required": ["startIndex", "endIndexExclusive", "totalCount"],
          "properties": {
            "startIndex": { "type": "integer", "minimum": 0 },
            "endIndexExclusive": { "type": "integer", "minimum": 0 },
            "totalCount": { "type": "integer", "minimum": 0 },
            "omittedBefore": { "type": "integer", "minimum": 0 },
            "omittedAfter": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "position": {
          "type": "object",
          "properties": {
            "positionInSet": { "type": "integer", "minimum": 1 },
            "setSize": { "type": "integer", "minimum": 1 },
            "level": { "type": "integer", "minimum": 1 },
            "rowIndex": { "type": "integer", "minimum": 1 },
            "rowCount": { "type": "integer", "minimum": 1 },
            "columnIndex": { "type": "integer", "minimum": 1 },
            "columnCount": { "type": "integer", "minimum": 1 },
            "columnLabel": { "type": "string" },
            "group": { "type": "string" }
          },
          "additionalProperties": false
        },
        "description": { "type": "string" },
        "controls": { "type": "string", "minLength": 1 },
        "labelledBy": { "type": "string", "minLength": 1 },
        "children": { "type": "array", "items": { "$ref": "#/$defs/accessibleNode" } }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "checked": true }, "required": ["checked"] },
          "then": { "type": "object", "properties": { "role": { "enum": ["checkbox", "switch", "radio", "menuitemcheckbox", "menuitemradio"] } } }
        },
        {
          "if": { "type": "object", "properties": { "checked": { "const": "mixed" } }, "required": ["checked"] },
          "then": { "type": "object", "properties": { "role": { "enum": ["checkbox", "menuitemcheckbox"] } } }
        },
        {
          "if": { "type": "object", "properties": { "selected": true }, "required": ["selected"] },
          "then": { "type": "object", "properties": { "role": { "enum": ["option", "tab", "row", "gridcell", "treeitem"] } } }
        },
        {
          "if": { "type": "object", "properties": { "expanded": true }, "required": ["expanded"] },
          "then": { "type": "object", "properties": { "role": { "enum": ["button", "combobox", "menuitem", "menuitemcheckbox", "menuitemradio", "treeitem"] } } }
        },
        {
          "if": { "type": "object", "properties": { "numericValue": true }, "required": ["numericValue"] },
          "then": { "type": "object", "properties": { "role": { "enum": ["progressbar", "meter", "slider", "spinbutton"] } } }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "numericValue": {
                "type": "object",
                "properties": { "indeterminate": { "const": true } },
                "required": ["indeterminate"]
              }
            },
            "required": ["numericValue"]
          },
          "then": { "type": "object", "properties": { "role": { "const": "progressbar" } } }
        },
        {
          "if": { "type": "object", "properties": { "role": { "const": "listbox" } }, "required": ["role"] },
          "then": { "type": "object", "properties": { "children": { "type": "array", "items": { "$ref": "#/$defs/optionNode" } } } }
        },
        {
          "if": { "type": "object", "properties": { "role": { "enum": ["menu", "menubar"] } }, "required": ["role"] },
          "then": { "type": "object", "properties": { "children": { "type": "array", "items": { "$ref": "#/$defs/menuItemNode" } } } }
        },
        {
          "if": { "type": "object", "properties": { "role": { "const": "combobox" } }, "required": ["role"] },
          "then": { "type": "object", "properties": { "children": { "type": "array", "items": { "$ref": "#/$defs/comboboxChildNode" } } } }
        },
        {
          "if": { "type": "object", "properties": { "role": { "const": "tablist" } }, "required": ["role"] },
          "then": { "type": "object", "properties": { "children": { "type": "array", "items": { "$ref": "#/$defs/tabNode" } } } }
        },
        {
          "if": { "type": "object", "properties": { "role": { "const": "radiogroup" } }, "required": ["role"] },
          "then": { "type": "object", "properties": { "children": { "type": "array", "items": { "$ref": "#/$defs/radioNode" } } } }
        },
        {
          "if": { "type": "object", "properties": { "role": { "enum": ["table", "grid"] } }, "required": ["role"] },
          "then": { "type": "object", "properties": { "children": { "type": "array", "items": { "$ref": "#/$defs/tableChildNode" } } } }
        },
        {
          "if": { "type": "object", "properties": { "role": { "const": "row" } }, "required": ["role"] },
          "then": { "type": "object", "properties": { "children": { "type": "array", "items": { "$ref": "#/$defs/tableCellNode" } } } }
        },
        {
          "if": { "type": "object", "properties": { "role": { "const": "rowgroup" } }, "required": ["role"] },
          "then": { "type": "object", "properties": { "children": { "type": "array", "items": { "$ref": "#/$defs/rowNode" } } } }
        },
        {
          "if": { "type": "object", "properties": { "role": { "const": "tree" } }, "required": ["role"] },
          "then": { "type": "object", "properties": { "children": { "type": "array", "items": { "$ref": "#/$defs/treeItemNode" } } } }
        }
      ],
      "additionalProperties": false
    },
    "optionNode": {
      "allOf": [{ "$ref": "#/$defs/accessibleNode" }, { "type": "object", "properties": { "role": { "enum": ["option", "group"] } } }]
    },
    "menuItemNode": {
      "allOf": [{ "$ref": "#/$defs/accessibleNode" }, { "type": "object", "properties": { "role": { "enum": ["menuitem", "menuitemcheckbox", "menuitemradio", "group"] } } }]
    },
    "comboboxChildNode": {
      "allOf": [{ "$ref": "#/$defs/accessibleNode" }, { "type": "object", "properties": { "role": { "enum": ["listbox", "status"] } } }]
    },
    "tabNode": {
      "allOf": [{ "$ref": "#/$defs/accessibleNode" }, { "type": "object", "properties": { "role": { "const": "tab" } } }]
    },
    "radioNode": {
      "allOf": [{ "$ref": "#/$defs/accessibleNode" }, { "type": "object", "properties": { "role": { "enum": ["radio", "group"] } } }]
    },
    "rowNode": {
      "allOf": [{ "$ref": "#/$defs/accessibleNode" }, { "type": "object", "properties": { "role": { "const": "row" } } }]
    },
    "tableChildNode": {
      "allOf": [{ "$ref": "#/$defs/accessibleNode" }, { "type": "object", "properties": { "role": { "enum": ["row", "rowgroup"] } } }]
    },
    "tableCellNode": {
      "allOf": [{ "$ref": "#/$defs/accessibleNode" }, { "type": "object", "properties": { "role": { "enum": ["cell", "gridcell", "columnheader", "rowheader"] } } }]
    },
    "treeItemNode": {
      "allOf": [{ "$ref": "#/$defs/accessibleNode" }, { "type": "object", "properties": { "role": { "enum": ["treeitem", "group"] } } }]
    }
  }
}
