{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ismail-elkorchi.dev/terminal-ui/terminal-capabilities.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "runtime",
    "isTty",
    "color",
    "unicode",
    "rawInput",
    "resize",
    "hyperlinks",
    "keyboardProtocol",
    "bracketedPaste",
    "mouseReporting",
    "alternateScreen",
    "focusReporting",
    "cursorVisibility",
    "synchronizedOutput",
    "scrollRegion",
    "title",
    "bell",
    "clipboard",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": { "const": "terminal-ui.terminal-capabilities.v1" },
    "runtime": { "enum": ["node", "deno", "bun", "memory"] },
    "isTty": { "type": "boolean" },
    "color": {
      "type": "object",
      "required": ["depth", "hasBasicColors", "has256Colors", "hasTrueColor"],
      "properties": {
        "depth": { "enum": [0, 1, 4, 8, 24] },
        "hasBasicColors": { "type": "boolean" },
        "has256Colors": { "type": "boolean" },
        "hasTrueColor": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "unicode": {
      "type": "object",
      "required": ["graphemeClusters", "widthProfile", "bidi"],
      "properties": {
        "graphemeClusters": { "const": true },
        "widthProfile": {
          "type": "object",
          "required": ["emoji", "ambiguous"],
          "properties": {
            "emoji": { "enum": ["narrow", "wide"] },
            "ambiguous": { "enum": ["narrow", "wide"] }
          },
          "additionalProperties": false
        },
        "bidi": { "enum": ["full", "stable-fallback"] }
      },
      "additionalProperties": false
    },
    "rawInput": { "$ref": "#/$defs/capabilitySupport" },
    "resize": { "$ref": "#/$defs/capabilitySupport" },
    "hyperlinks": { "$ref": "#/$defs/capabilitySupport" },
    "keyboardProtocol": { "$ref": "#/$defs/capabilitySupport" },
    "bracketedPaste": { "$ref": "#/$defs/capabilitySupport" },
    "mouseReporting": { "$ref": "#/$defs/capabilitySupport" },
    "alternateScreen": { "$ref": "#/$defs/capabilitySupport" },
    "focusReporting": { "$ref": "#/$defs/capabilitySupport" },
    "cursorVisibility": { "$ref": "#/$defs/capabilitySupport" },
    "synchronizedOutput": { "$ref": "#/$defs/capabilitySupport" },
    "scrollRegion": { "$ref": "#/$defs/capabilitySupport" },
    "title": { "$ref": "#/$defs/capabilitySupport" },
    "bell": { "$ref": "#/$defs/capabilitySupport" },
    "clipboard": { "$ref": "#/$defs/capabilitySupport" },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "https://schemas.ismail-elkorchi.dev/terminal-ui/terminal-diagnostic.schema.json" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "capabilitySupport": {
      "type": "object",
      "required": ["support", "availability", "facts", "diagnostics", "requiresSessionOperation"],
      "properties": {
        "support": { "enum": ["supported", "unsupported", "unknown"] },
        "availability": { "enum": ["available", "unavailable"] },
        "facts": {
          "type": "array",
          "items": { "$ref": "#/$defs/capabilitySourceFact" }
        },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "https://schemas.ismail-elkorchi.dev/terminal-ui/terminal-diagnostic.schema.json" }
        },
        "requiresSessionOperation": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "capabilitySourceFact": {
      "type": "object",
      "required": ["kind", "name", "value"],
      "properties": {
        "kind": { "enum": ["host", "environment", "probe", "override"] },
        "name": { "type": "string", "minLength": 1 },
        "value": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" },
            {
              "type": "array",
              "items": {}
            },
            {
              "type": "object",
              "additionalProperties": {}
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
